# ===== DeepSeek（必填）=====
DEEPSEEK_API_KEY=             # 摘要/金句/广告标记用
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ===== 转写引擎（本地，轻量方案）=====
# 主模型：SenseVoiceSmall（参数量约 2.3 亿；fp32 磁盘约 940MB，int8 运行时内存约 240MB）
# 注意：SenseVoiceSmall 默认不输出时间戳，需 VAD 分段 + 时间戳后处理（详见 M2）
# 注意：必须用完整 model id——funasr 1.4.11 短别名解析有 bug（404）
ASR_MODEL=iic/SenseVoiceSmall  # 主转写模型（轻量，int8 加载）
ASR_VAD_MODEL=iic/speech_fsmn_vad_zh-cn-16k-common-pytorch  # VAD 语音活动检测（分段 + 起止时间）
ASR_PUNC_MODEL=iic/punc_ct-transformer_zh-cn-common-vocab272727-pytorch  # 标点恢复（zh-only 版约 290MB；别名 ct-punc 实为 1.1G cn-en large，不采用）
ASR_DEVICE=cpu                 # cpu / cuda
ASR_BATCH_SIZE=1

# ===== 存储 =====
DATA_DIR=./data

# ===== 语义搜索 =====
EMBEDDING_MODEL=bge-small-zh-v1.5   # 本地中文 embedding
